# Supabase Cloud Database Configuration
# 1. Sign up / log in to https://supabase.com
# 2. Create a new project (e.g. qudwa-2026)
# 3. Go to Project Settings -> API to copy Project URL and Project API anon key
# 4. Paste them here:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
